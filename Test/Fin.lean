import Smt

-- Quantifiers range over exactly the integers in [0, n).
example : ∀ _ : Fin 0, False := by smt
example : ¬ ∃ _ : Fin 0, True := by smt
example : ∃ _ : Fin 1, True := by smt
example (i : Fin 1) : i = 0 := by smt
example : (5 : Fin 3) = 2 := by smt
example (i : Fin 3) : i = 0 ∨ i = 1 ∨ i = 2 := by smt
example : ∃ i : Fin 5, i.val = 4 := by smt
example (n : Nat) (i : Fin n) : 0 < n := by smt
example (n : Nat) (i : Fin n) : ∃ j : Fin n, j = i := by smt
example (n : Nat) (i j : Fin n) (h : i ≠ j) : i.val ≠ j.val := by smt [h]
example (n : Nat) (i j : Fin n) (h : i < j) : i ≤ j := by smt [h]

-- Function arguments and results can use different symbolic bounds.
example (f : Fin 4 → Fin 4 → Bool) : f 0 0 = f 0 0 := by smt
example (n : Nat) (p : Fin n → Bool) : ∀ i, p i = p i := by smt
example (n : Nat) (f : Nat → Fin n) (a : Nat) : (f a).val < n := by smt
example (n : Nat) (f : Nat → Nat → Nat → Nat → Nat → Fin n) (a : Nat) :
    (f a a a a a).val < n := by smt
example (α : Type) (n : Nat) (f : α → Fin n) (a : α) : (f a).val < n := by smt
example (m n : Nat) (f : Fin m → Fin n) : ∀ i, (f i).val < n := by smt
example (n : Nat) (r : Nat → Fin n → Bool) (h : ∀ k i, r k i = true → i.val < k) :
    ∀ k i, r k i = true → i.val < k + 1 := by smt [h]

-- Weakest-precondition and transition-relation obligations generated by Veil #173.
example (n k j : Nat) (hk : k < n) (hj : j < n) (c : Fin n → Nat) (h : ∀ i, c i ≤ 3) :
    (if (⟨k, hk⟩ : Fin n) = ⟨j, hj⟩ then 3 else c ⟨j, hj⟩) ≤ 3 := by
  smt [hk, hj, h]

example (n k : Nat) (hk : k < n) (c c' : Fin n → Nat) (h : ∀ i, c i ≤ 3)
    (update : ∀ i, (if (⟨k, hk⟩ : Fin n) = i then 3 else c i) = c' i) (j : Fin n) :
    c' j ≤ 3 := by smt [hk, h, update]

private abbrev NoIndex := Fin 0
private abbrev NoIndexOutput (α : Type) := α → Fin 0
private abbrev EmptyFunction := Fin 1 → NoIndex
private class Witness (α : Type) where value : α
private instance [w : Witness α] : Inhabited (Witness α) := ⟨w⟩
private instance [w : Witness α] : Inhabited α := ⟨w.value⟩

private abbrev Index (n : Nat) := Fin n
private def DefinedIndex (n : Nat) := Index n
private abbrev UnaryIndex (n : Nat) := Nat → Index n
private def EmptyProduct := Prod NoIndex Unit
private structure EmptyRecord where
  index : NoIndex
private def HiddenRecord := EmptyRecord

example (n : Nat) (i : Index n) : i.val < n := by smt
example (n : Nat) (i : DefinedIndex n) : i.val < n := by smt
example (n : Nat) (i : Index n) : 0 < n := by smt
example (n : Nat) (f : UnaryIndex n) (a : Nat) : (f a).val < n := by smt
example (α : Type) (_a : α) (_f : α → Fin 0) : False := by smt
example (α : Type) (h : Nonempty α) (_f : α → Fin 0) : False := by smt [h]
example (f : (k : Nat) → Fin (k + 1)) (_i : Fin ((f 0).val + 1)) : True := by smt
example (α : Type) (_a : α) (p : Fin 1 → α → Bool) :
    ∃ a, p 0 a = true ∨ p 0 a = false := by smt +trust

/-- error: [embedding] Fin in this function signature requires support beyond five arguments -/
#guard_msgs in
example (n : Nat) (f : Nat → Nat → Nat → Nat → Nat → Nat → Fin n) (a : Nat) :
    (f a a a a a a).val + 1 ≤ n := by smt

-- These false statements must be rejected even when trusting the solver's answer.
example : True := by
  fail_if_success have : ∃ _ : Fin 0, True := by smt +trust
  fail_if_success have : ∀ _ : Fin 1, False := by smt +trust
  fail_if_success have : ∀ i : Fin 2, i = 0 := by smt +trust
  fail_if_success have : ∀ _ : Fin 0 → Empty, False := by smt +trust
  fail_if_success have : ∀ _ : Fin 0 → Fin 0, False := by smt +trust
  fail_if_success
    have bad (n : Nat) (p : Fin n → Bool) (id : Fin n) : ∀ i, p i = true → i = id := by smt +trust
  fail_if_success have bad (cast : NatCast Int) : @Nat.cast Int cast 0 = 0 := by smt +trust
  fail_if_success have : ∃ i : NoIndex, i = i := by smt +trust
  fail_if_success have : ∃ i : NoIndex, i = i := by smt -embeddings +trust
  fail_if_success
    have bad (α : Type) (f : α → Fin 0) (h : ∀ a, (f a).val < 1) : False := by smt +trust [h]
  fail_if_success
    have bad (α : Type) (f : NoIndexOutput α) (h : ∀ a, (f a).val = 0) : False := by smt +trust [h]
  fail_if_success
    have bad (α : Type) (f : α → Fin 0) (_h : ∀ a, (f a).val = 0) (z : Nat) :
        False ∧ (z = 3 ∨ ∃ _ : α, True) := by smt +trust
  fail_if_success have : ∃ f : EmptyFunction, f = f := by smt +trust
  fail_if_success
    have bad (α : Type) (f : [Witness α] → α → Fin 0)
        (h : ∀ [w : Witness α] (a : α), (@f w a).val = 0) : False := by smt +trust [@h]
  fail_if_success have : ∃ x : EmptyProduct, x = x := by smt +trust
  fail_if_success have : ∃ x : HiddenRecord, x = x := by smt +trust
  fail_if_success
    have bad (α : Type) (p : Fin 1 → α → Bool) : ∃ a, p 0 a = true ∨ p 0 a = false := by smt +trust
  fail_if_success have bad (α : Type) : ∃ _ : α, ∀ i : Fin 1, i = 0 := by smt +trust
  fail_if_success
    have bad (α : Type) (_f : Fin 0 → α → Fin 0) : ∃ _ : α, True := by smt +trust
  trivial
